rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is a signed-in login whose email is on the Settings > Users
    // list (settings/users.emails). Anyone can create a Firebase login with
    // the public web config, so being signed in alone isn't enough.
    function adminListPath() {
      return /databases/$(database)/documents/settings/users;
    }
    function signedInEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && signedInEmail() in get(adminListPath()).data.emails;
    }
    // True only before the admin list has ever been set up.
    function noAdminListYet() {
      return !exists(adminListPath()) || !('emails' in get(adminListPath()).data);
    }

    // Students: the kiosk needs to read names to power the search bar,
    // and Firestore rules can't hide individual fields, so treat this as
    // "visible to anyone with the kiosk link" (fine for a locked iPad in
    // your studio). Only an admin can add/edit/remove students.
    match /students/{studentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sessions: the kiosk creates a sign-in record with no login needed.
    // Only an admin can read the list, edit, or delete one.
    match /sessions/{sessionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Bookings: the kiosk needs to read today's slots to offer them at
    // sign-in, and can create a one-off (non-repeating, single-day) booking
    // when a student signs in with no scheduled session, so it shows up on
    // the calendar too. Only an admin can edit/delete, or create anything
    // recurring or multi-day.
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.repeat == 'none' &&
        request.resource.data.startDate == request.resource.data.endDate
      );
      allow update, delete: if isAdmin();
    }

    // Online registration. The /register page needs to read the live form
    // (and which one is live) without a login; only admins can change them.
    match /publicSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /registrationForms/{formId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Submissions: anyone can send one, shaped like the form sends it, but
    // only an admin can read, approve, reject or delete them. They hold ID
    // numbers, addresses and signatures, so they're never public.
    match /registrations/{registrationId} {
      allow create: if request.resource.data.keys().hasOnly(['formId', 'year', 'lang', 'status', 'submittedAt', 'answers', 'signatures', 'form'])
        && request.resource.data.status == 'new'
        && request.resource.data.submittedAt == request.time
        && request.resource.data.formId is string
        && request.resource.data.formId.size() < 40
        && request.resource.data.lang in ['en', 'af']
        && request.resource.data.answers is map
        && request.resource.data.answers.size() < 200
        && request.resource.data.signatures is map
        && request.resource.data.signatures.size() <= 5
        && request.resource.data.form is map;
      allow read, update, delete: if isAdmin();
    }

    // Student groups (shortcuts for filling in bookings): admins only.
    match /groups/{groupId} {
      allow read, write: if isAdmin();
    }

    // Invoices and settings: admins only.
    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
    }
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // First-time setup of the admin list: before it exists, the first
    // signed-in tutor may create it, but only with themselves on it.
    match /settings/users {
      allow read: if request.auth != null && noAdminListYet();
      allow write: if request.auth != null
        && request.auth.token.email != null
        && noAdminListYet()
        && signedInEmail() in request.resource.data.emails;
    }
  }
}
