rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Students: the kiosk needs to read names to power the search bar,
    // and Firestore rules can't hide individual fields, so treat this as
    // "visible to anyone with the kiosk link" (fine for a locked iPad in
    // your studio). Only a signed-in tutor can add/edit/remove students.
    match /students/{studentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Sessions: the kiosk creates a sign-in record with no login needed.
    // Only the tutor (signed in) can read the list, edit, or delete one.
    match /sessions/{sessionId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Bookings: the kiosk needs to read today's slots to offer them at
    // sign-in. Only the tutor can create/edit/delete bookings.
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Invoices and settings: tutor only.
    match /invoices/{invoiceId} {
      allow read, write: if request.auth != null;
    }
    match /settings/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
