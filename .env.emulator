# Used by `npm run dev:emulator`: the app talks to the local Firebase
# emulators (npm run emulators) instead of the live project. The "demo-"
# project id means the emulators never reach a real Firebase project.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-multiplying-minds.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-multiplying-minds
VITE_FIREBASE_STORAGE_BUCKET=demo-multiplying-minds.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app
